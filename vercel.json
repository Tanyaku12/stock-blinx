{
  "version": 2,
  "name": "stock-blinx",
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "RAPI/**" }
    },
    { "src": "web/**", "use": "@vercel/static" },
    { "src": "RAPI/all.txt", "use": "@vercel/static" },
    { "src": "RAPI/sold.txt", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/stock", "destination": "/api/stock.py" },
    { "source": "/api/bonus", "destination": "/api/bonus.py" },
    { "source": "/api/telegram", "destination": "/api/telegram.py" },
    { "source": "/RAPI/all.txt", "destination": "/RAPI/all.txt" },
    { "source": "/RAPI/sold.txt", "destination": "/RAPI/sold.txt" },
    { "source": "/bonus", "destination": "/web/bonus.html" },
    { "source": "/bonus.html", "destination": "/web/bonus.html" },
    { "source": "/(.*)", "destination": "/web/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
